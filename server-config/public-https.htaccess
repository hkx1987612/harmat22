# BEGIN Harmat public HTTPS
# The hosting proxy overwrites X-Forwarded-Proto; native HTTPS is off in rewrite.
# Keep submissions, APIs, logins and private portals on their existing paths.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?harmat22\.hu(:80)?$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} ^http$ [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(wp-admin|wp-json|agent|sales|sales-admin|client|customer|ugyfel)(/|$) [NC]
RewriteCond %{REQUEST_URI} !\.php(/|$) [NC]
RewriteCond %{QUERY_STRING} !(^|&)(rest_route|action|_wpnonce|_ajax_nonce|nonce|token|key|preview|preview_id|preview_nonce|harmat_agent_portal|harmat_sales_portal|harmat_customer_portal|harmat_sales_shortcut)= [NC]
RewriteRule ^ https://harmat22.hu%{REQUEST_URI} [R=301,L,NE]
</IfModule>
# END Harmat public HTTPS
